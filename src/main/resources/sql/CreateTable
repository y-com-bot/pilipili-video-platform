create table `user`(
    `id` bigint primary key auto_increment comment '用户主键id',
    `username` varchar(50) unique key not null comment '不可重复的用户名',
    `password` varchar(255) not null comment'哈希加密后的密码',
    `salt` varchar(50) not null comment '加密盐值，用于防彩虹表破解',
    `role` enum('user','admin') default 'user' comment'用户角色：user普通用户, admin管理员',
    `create_time` datetime default current_timestamp comment'注册时间',
    unique key `uk_username` (`username`)
) engine=innodb default charset=utf8mb4 comment='用户信息表';

create table `video`(
    `id` bigint primary key auto_increment comment'视频主键id',
    `title` varchar(100) not null comment'视频标题',
    `description` text comment'视频简介',
    `uploader_id` bigint not null comment'博主id',
    `video_url` varchar(255) not null comment'视频url',
    `create_time` datetime default current_timestamp comment '发布时间',
    key `idx_uploader` (`uploader_id`)
)engine=innodb default charset=utf8mb4 comment'视频信息表'